//This way we can use that StompClient to subscribe, sendmessage/publish, etc.
import React, { useEffect } from "react";
import { useWebSocket } from "./WebSocketContext";

function ChatRoom() {
  const { subscribe, sendMessage } = useWebSocket();

  useEffect(() => {
    const sub = subscribe("/user/queue/messages", (msg) => {
      const body = JSON.parse(msg.body);
      console.log("📩 New private message:", body);
    });

    return () => sub && sub.unsubscribe();
  }, [subscribe]);

  const handleSend = () => {
    sendMessage("/app/chat.private", { receiver: "B", text: "Hello B!" });
  };

  return <button onClick={handleSend}>Send Private Message</button>;
}

export default ChatRoom;
